# Copie para .env e preencha. O arquivo .env NÃO vai para o Git.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/pdv_db"

# Gere valores longos e aleatórios, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SUPER_ADMIN_SECRET=

# Opcional: envio de e-mail de fechamento (Gmail com senha de app)
EMAIL_USER=
EMAIL_PASS=

PORT=3000
